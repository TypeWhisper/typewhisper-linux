#: crates/typewhisper/src/app.rs
msgid "Starting…"
msgstr "Wird gestartet …"

#: crates/typewhisper/src/app.rs
msgid "Needs Access"
msgstr "Zugriff erforderlich"

#: crates/typewhisper/src/app.rs
msgid "Access is still needed before text can be pasted into other apps."
msgstr "Bevor Text in andere Apps eingefügt werden kann, ist noch Zugriff nötig."

#: crates/typewhisper/src/app.rs
msgid "No hotkey"
msgstr "Kein Tastenkürzel"

#: crates/typewhisper/src/app.rs
msgid "A hotkey still needs to be set before dictation can start."
msgstr "Bevor das Diktat starten kann, muss noch ein Tastenkürzel festgelegt werden."

#: crates/typewhisper/src/app.rs
msgid "Downloading model…"
msgstr "Modell wird heruntergeladen …"

#: crates/typewhisper/src/app.rs
msgid "No model loaded"
msgstr "Kein Modell geladen"

#: crates/typewhisper/src/app.rs
msgid "A speech model still needs to be downloaded before dictation can run."
msgstr "Bevor du diktieren kannst, muss noch ein Sprachmodell heruntergeladen werden."

#: crates/typewhisper/src/app.rs
msgid "The speech model stopped unexpectedly. Restart it below."
msgstr "Das Sprachmodell wurde unerwartet beendet. Starte es unten neu."

#. Leave {key} as it is.
#: crates/typewhisper/src/app.rs
msgid "Press {key} in any app to begin."
msgstr "Drücke {key} in einer beliebigen App, um loszulegen."

#: crates/typewhisper/src/app.rs
msgid "Ready to start dictating?"
msgstr "Bereit zum Diktieren?"

