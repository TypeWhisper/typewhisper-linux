msgstr "Antwort von {model}"

#: crates/typewhisper/src/server_profiles.rs
msgid "Discard Changes?"
msgstr "Änderungen verwerfen?"

#: crates/typewhisper/src/server_profiles.rs
msgid "The changes to this profile are not saved."
msgstr "Die Änderungen an diesem Profil sind nicht gespeichert."

#: crates/typewhisper/src/server_profiles.rs
msgid "Keep Editing"
msgstr "Weiter bearbeiten"

#: crates/typewhisper/src/server_profiles.rs
msgid "Discard"
msgstr "Verwerfen"

