      "name": "parakeet",
      "license-files": ["LICENSE", "packaging/licenses/parakeet-crates.txt"],
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/parakeet/cargo",
          "CARGO_NET_OFFLINE": "true",
          "SHERPA_ONNX_LIB_DIR": "/app/plugins/Parakeet/lib"
        }
      },
      "build-commands": [
        "cargo build --release --locked --offline -p tw-plugin-parakeet",
        "install -Dm755 target/release/tw-plugin-parakeet ${FLATPAK_DEST}/com.typewhisper.parakeet/bin/tw-plugin-parakeet",
        "install -Dm644 plugins/parakeet/manifest.json ${FLATPAK_DEST}/com.typewhisper.parakeet/manifest.json",
        "tools/i18n/translate-packaging.sh translated",
        "install -Dm644 translated/com.typewhisper.TypeWhisper.Plugin.Parakeet.metainfo.xml ${FLATPAK_DEST}/share/metainfo/com.typewhisper.TypeWhisper.Plugin.Parakeet.metainfo.xml"
