{
  "id": "com.typewhisper.TypeWhisper.Plugin.Parakeet",
  "runtime": "com.typewhisper.TypeWhisper",
  "runtime-version": "master",
  "sdk": "org.gnome.Sdk//51",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "build-extension": true,
  "separate-locales": false,
  "build-options": {
    "prefix": "/app/plugins/Parakeet",
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "onnxruntime",
      "buildsystem": "cmake-ninja",
      "subdir": "cmake",
      "builddir": true,
      "no-make-install": true,
      "build-options": {
        "cflags": "-g0",
        "cxxflags": "-g0"
      },
      "config-opts": [
        "--compile-no-warning-as-error",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_PROJECT_onnxruntime_INCLUDE=/run/build/onnxruntime/onnxruntime-link-probe.cmake",
        "-DFETCHCONTENT_TRY_FIND_PACKAGE_MODE=NEVER",
        "-Donnxruntime_BUILD_SHARED_LIB=OFF",
        "-Donnxruntime_BUILD_UNIT_TESTS=OFF",
        "-Donnxruntime_BUILD_BENCHMARKS=OFF",
        "-Donnxruntime_ENABLE_PYTHON=OFF",
        "-Donnxruntime_USE_XNNPACK=OFF",
        "-Donnxruntime_USE_KLEIDIAI=OFF",
        "-Donnxruntime_DISABLE_RTTI=OFF"
      ],
      "post-install": [
        "install -Dm644 -t ${FLATPAK_DEST}/include/onnxruntime /run/build/onnxruntime/include/onnxruntime/core/session/onnxruntime_*.h /run/build/onnxruntime/include/onnxruntime/core/session/onnxruntime_*.inc /run/build/onnxruntime/include/onnxruntime/core/providers/cpu/cpu_provider_factory.h",
        "install -d ${FLATPAK_DEST}/lib",
        "cd /run/build/onnxruntime/cmake/_flatpak_build && ninja -t commands onnxruntime_link_probe | tail -n 1 | tr ' ' '\\n' | grep '\\.a$' | awk '!seen[$0]++' | sed 's/^/ADDLIB /' | { echo \"CREATE $FLATPAK_DEST/lib/libonnxruntime.a\"; cat; echo SAVE; echo END; } | ar -M",
        "for src in /run/build/onnxruntime/cmake/_flatpak_build/_deps/*-src; do for f in \"$src\"/LICENSE* \"$src\"/COPYING*; do if [ -f \"$f\" ]; then install -Dm644 \"$f\" \"$FLATPAK_DEST/share/licenses/$FLATPAK_ID/onnxruntime/$(basename \"$src\" -src)/$(basename \"$f\")\"; fi; done; done"
      ],
      "license-files": ["LICENSE", "ThirdPartyNotices.txt"],
      "cleanup": ["/include", "/lib"],
      "sources": [
