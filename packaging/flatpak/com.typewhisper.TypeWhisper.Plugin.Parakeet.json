{
  "id": "com.typewhisper.TypeWhisper.Plugin.Parakeet",
  "runtime": "com.typewhisper.TypeWhisper",
  "runtime-version": "master",
  "sdk": "org.gnome.Sdk//51",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "build-extension": true,
  "separate-locales": false,
  "build-options": {
    "prefix": "/app/plugins/Parakeet",
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "onnxruntime",
      "buildsystem": "simple",
      "build-commands": [
        "bsdtar -xf onnxruntime.zip --no-same-owner --strip-components 1",
        "install -Dm644 -t ${FLATPAK_DEST}/lib lib/libonnxruntime.a",
        "install -Dm644 -t ${FLATPAK_DEST}/include/onnxruntime include/*.h"
      ],
      "cleanup": ["/include", "/lib"],
      "sources": [
        {
          "type": "file",
          "only-arches": ["x86_64"],
          "url": "https://github.com/csukuangfj/onnxruntime-libs/releases/download/v1.28.2/onnxruntime-linux-x64-static_lib-1.28.2-glibc2_17.zip",
          "dest-filename": "onnxruntime.zip",
          "sha256": "2dada92465b40a16fb5011956d93eaf90e3091cf621a953e5371a5e6a687794e"
        },
        {
          "type": "file",
          "only-arches": ["aarch64"],
          "url": "https://github.com/csukuangfj/onnxruntime-libs/releases/download/v1.28.2/onnxruntime-linux-aarch64-static_lib-1.28.2-glibc2_17.zip",
          "dest-filename": "onnxruntime.zip",
          "sha256": "fba13fa68dbc9305512869bfa74f53a15e7af983c44ba8a9cbecbce5c21b33b3"
        }
      ]
    },
    {
      "name": "sherpa-onnx",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_SHARED_LIBS=OFF",
        "-DSHERPA_ONNX_ENABLE_C_API=ON",
        "-DSHERPA_ONNX_ENABLE_BINARY=OFF",
        "-DSHERPA_ONNX_BUILD_C_API_EXAMPLES=OFF",
        "-DSHERPA_ONNX_ENABLE_PORTAUDIO=OFF",
        "-DSHERPA_ONNX_ENABLE_WEBSOCKET=OFF",
        "-DSHERPA_ONNX_ENABLE_PYTHON=OFF",
        "-DSHERPA_ONNX_ENABLE_TESTS=OFF",
        "-DSHERPA_ONNX_USE_PRE_INSTALLED_ONNXRUNTIME_IF_AVAILABLE=ON"
      ],
      "build-options": {
        "env": {
          "SHERPA_ONNXRUNTIME_LIB_DIR": "/app/plugins/Parakeet/lib",
          "SHERPA_ONNXRUNTIME_INCLUDE_DIR": "/app/plugins/Parakeet/include/onnxruntime"
        }
      },
      "post-install": [
        "for src in /run/build/sherpa-onnx/_flatpak_build/_deps/*-src; do for f in \"$src\"/LICENSE* \"$src\"/COPYING* \"$src\"/LICENSES/*; do if [ -f \"$f\" ]; then install -Dm644 \"$f\" \"$FLATPAK_DEST/share/licenses/$FLATPAK_ID/$(basename \"$src\" -src)/$(basename \"$f\")\"; fi; done; done"
      ],
      "cleanup": ["/include", "/lib", "/sherpa-onnx.pc"],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/k2-fsa/sherpa-onnx/archive/refs/tags/v2.0.3.tar.gz",
          "sha256": "40e2ded061e16eda9750a49d1dee78ba308d5c37fc544108d8a660611d3b4c8d"
        },
        {
          "type": "file",
          "url": "https://github.com/csukuangfj/kaldi-native-fbank/archive/refs/tags/v1.23.1.tar.gz",
          "dest-filename": "kaldi-native-fbank-1.23.1.tar.gz",
          "sha256": "c9722d55bf791d591baf6f79c8db8c66b7eeacf3bec59a4ac37864eacf2e8f37"
        },
        {
          "type": "file",
          "url": "https://github.com/csukuangfj/kaldi_native_io/archive/refs/tags/v1.23.2.tar.gz",
          "dest-filename": "kaldi_native_io-1.23.2.tar.gz",
          "sha256": "8c0eadd3aa2d9cafe62e82c2e3075a57bc41cac7e83f9553671413f07b070426"
        },
        {
          "type": "file",
          "url": "https://github.com/mborgerding/kissfft/archive/febd4caeed32e33ad8b2e0bb5ea77542c40f18ec.zip",
          "dest-filename": "kissfft-febd4caeed32e33ad8b2e0bb5ea77542c40f18ec.zip",
          "sha256": "497103e664168ebe39580b757adbe616f6cf85a16572af581ca7bc42d0ab13fd"
        },
        {
          "type": "file",
          "url": "https://github.com/csukuangfj/openfst/archive/refs/tags/v1.8.5-2026-07-09.tar.gz",
          "dest-filename": "openfst-1.8.5-2026-07-09.tar.gz",
          "sha256": "2ff712a32952fcb01d351121a6bc8ccf4fdc6b2aa06ce8df2b3095dedd518c0e"
        },
        {
          "type": "file",
          "url": "https://github.com/JuliaStrings/utf8proc/archive/refs/tags/v2.12.0.tar.gz",
          "dest-filename": "utf8proc-2.12.0.tar.gz",
          "sha256": "f564011d38b2888d583d510b08e69ffa15aa117155db1b9b49ef1dfe1fa25111"
        },
        {
          "type": "file",
          "url": "https://github.com/k2-fsa/kaldifst/archive/refs/tags/v1.9.0.tar.gz",
          "dest-filename": "kaldifst-1.9.0.tar.gz",
          "sha256": "225d8377d1d262e3aedab23558fead106b4cbc83462fb29f1c5e7d9e3b0c14dd"
        },
        {
          "type": "file",
          "url": "https://github.com/k2-fsa/kaldi-decoder/archive/refs/tags/v0.4.0.tar.gz",
          "dest-filename": "kaldi-decoder-0.4.0.tar.gz",
          "sha256": "078f2ebb9927c19445096549f880b4ac6db14b7eeb263062f50697873901c955"
        },
        {
          "type": "file",
          "url": "https://github.com/csukuangfj/kaldi-hmm-gmm/archive/refs/tags/v1.2.1.tar.gz",
          "dest-filename": "kaldi-hmm-gmm-1.2.1.tar.gz",
          "sha256": "8344681ef464373bab54d548877ffa1cc82c16097e4f0975ce7b497c2e5b6e33"
        },
        {
          "type": "file",
          "url": "https://github.com/pkufool/simple-sentencepiece/archive/refs/tags/v0.7.tar.gz",
          "dest-filename": "simple-sentencepiece-0.7.tar.gz",
          "sha256": "1748a822060a35baa9f6609f84efc8eb54dc0e74b9ece3d82367b7119fdc75af"
        },
        {
          "type": "file",
          "url": "https://github.com/nlohmann/json/archive/refs/tags/v3.12.0.tar.gz",
          "dest-filename": "json-3.12.0.tar.gz",
          "sha256": "4b92eb0c06d10683f7447ce9406cb97cd4b453be18d7279320f7b2f025c10187"
        },
        {
          "type": "file",
          "url": "https://github.com/csukuangfj/hclust-cpp/archive/refs/tags/2026-02-25.tar.gz",
          "dest-filename": "hclust-cpp-2026-02-25.tar.gz",
          "sha256": "8f14e024c709d73afb40ae69cb22de4b73dba67cbce40f2e518813da8139ab56"
        },
        {
          "type": "file",
          "url": "https://gitlab.com/libeigen/eigen/-/archive/5.0.1/eigen-5.0.1.tar.gz",
          "sha256": "e9c326dc8c05cd1e044c71f30f1b2e34a6161a3b6ecf445d56b53ff1669e3dec"
        }
      ]
    },
    {
      "name": "parakeet",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/parakeet/cargo",
          "CARGO_NET_OFFLINE": "true",
          "SHERPA_ONNX_LIB_DIR": "/app/plugins/Parakeet/lib"
        }
      },
      "build-commands": [
        "cargo build --release --locked --offline -p tw-plugin-parakeet",
        "install -Dm755 target/release/tw-plugin-parakeet ${FLATPAK_DEST}/com.typewhisper.parakeet/bin/tw-plugin-parakeet",
        "install -Dm644 plugins/parakeet/manifest.json ${FLATPAK_DEST}/com.typewhisper.parakeet/manifest.json",
        "tools/i18n/translate-packaging.sh translated",
        "install -Dm644 translated/com.typewhisper.TypeWhisper.Plugin.Parakeet.metainfo.xml ${FLATPAK_DEST}/share/metainfo/com.typewhisper.TypeWhisper.Plugin.Parakeet.metainfo.xml"
      ],
      "sources": [
        { "type": "dir", "path": "../..", "skip": ["target", ".flatpak-builder", "build-dir", "repo", ".git"] },
        "cargo-sources.json"
      ]
    }
  ]
}
