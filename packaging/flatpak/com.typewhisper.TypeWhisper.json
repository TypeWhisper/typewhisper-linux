{
  "id": "com.typewhisper.TypeWhisper",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "typewhisper",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--share=ipc",
    "--share=network",
    "--device=dri",
    "--talk-name=org.a11y.Bus",
    "--filesystem=xdg-run/at-spi"
  ],
  "add-extensions": {
    "com.typewhisper.TypeWhisper.Plugin": {
      "directory": "plugins",
      "subdirectories": true,
      "no-autodownload": true,
      "autodelete": true
    }
  },
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/typewhisper/cargo",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "modules": [
    {
      "name": "gtk4-layer-shell",
      "buildsystem": "meson",
      "config-opts": [
        "-Dexamples=false",
        "-Ddocs=false",
        "-Dtests=false",
        "-Dsmoke-tests=false",
        "-Dintrospection=false",
        "-Dvapi=false"
      ],
      "cleanup": ["/include", "/lib/pkgconfig", "/lib/liblayer-shell-preload.so"],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/wmww/gtk4-layer-shell/archive/refs/tags/v1.3.0.tar.gz",
          "sha256": "1ebb01ab14e98afd1727f68f64981c37bd23305b1f131f5667c02b94cf593192"
        }
      ]
    },
    {
      "name": "typewhisper",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --locked --offline -p typewhisper",
        "install -Dm755 target/release/typewhisper /app/bin/typewhisper",
        "tools/i18n/build-catalogs.sh /app/share/locale",
        "install -d /app/plugins",
        "install -Dm644 packaging/com.typewhisper.TypeWhisper.desktop /app/share/applications/com.typewhisper.TypeWhisper.desktop",
        "install -Dm644 packaging/com.typewhisper.TypeWhisper.svg /app/share/icons/hicolor/scalable/apps/com.typewhisper.TypeWhisper.svg",
        "install -Dm644 packaging/com.typewhisper.TypeWhisper.metainfo.xml /app/share/metainfo/com.typewhisper.TypeWhisper.metainfo.xml"
      ],
      "sources": [
        { "type": "dir", "path": "../..", "skip": ["target", ".flatpak-builder", "build-dir", "repo", ".git"] },
        "cargo-sources.json"
      ]
    }
  ]
}
